rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      // Guest checkout remains intentionally disabled at the database layer
      // until a constrained guest-order write model is implemented.
      allow create: if isAdmin();
    }

    match /admins/{uid} {
      // Admin status comes from the Firebase Auth custom claim.
      // Client-side writes are disabled so users cannot grant themselves admin.
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}